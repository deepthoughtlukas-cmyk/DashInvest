# Backend Server Port (lokale Entwicklung)
PORT=3001

# Optionale API-Keys für spätere Erweiterung / höhere Rate-Limits
# Standardmäßig läuft DashInvest komplett ohne API-Keys über FRED CSV & Yahoo Finance
FRED_API_KEY=
TWELVEDATA_API_KEY=
POLYGON_API_KEY=

# Optionaler Pfad zum lokalen Patty-Projektordner (Standard: ../Stockpicker)
# PATTY_DIR=../Stockpicker
PATTY_DIR=
