# Backend Server Port (lokale Entwicklung)
PORT=3001

# Optionale API-Keys für spätere Erweiterung / höhere Rate-Limits
# Standardmäßig läuft DashInvest komplett ohne API-Keys über FRED CSV & Yahoo Finance
FRED_API_KEY=
TWELVEDATA_API_KEY=
POLYGON_API_KEY=

# --- GitHub Pages & Cloud-Deployment (Variante 2) ---
# URL des deployten Cloudflare Workers für Live-Kurse (z. B. https://dashinvest-api.<subdomain>.workers.dev)
VITE_API_BASE_URL=

# Firebase Web App Config (Spark Free Tier: Google Sign-In + Cloud Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
